# ==========================================================
# AI VIDEO STUDIO - BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in your values.
# ==========================================================

# 1. AI Video Provider Selection
# Options: "auto" (uses fal if FAL_KEY is set, otherwise demo), "fal", "demo"
VIDEO_PROVIDER=auto

# 2. fal.ai Official API Key (Get one at https://fal.ai/dashboard/keys)
# Leave blank to run in honest Demo Mode (zero cost, labeled sample videos)
FAL_KEY=

# Optional: fal.ai Model Endpoints (Can be customized)
FAL_T2V_MODEL=fal-ai/wan-t2v
FAL_I2V_MODEL=fal-ai/wan-i2v

# 3. Optional: Gemini / OpenAI API Key for AI Prompt Enhancement
# If left blank, uses our built-in deterministic Cinematic Prompt Enhancer engine
GEMINI_API_KEY=

# 4. Database Configuration
# Local development uses SQLite. For production PostgreSQL, change to:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./studio.db

# 5. Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=10
STORAGE_DIR=./uploads

# 6. Security & Cost Controls
DAILY_GENERATION_LIMIT=20
MAX_REQUESTS_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
